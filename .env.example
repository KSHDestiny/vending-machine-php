# Local Docker Compose values only. Replace the placeholders before use.
LOCAL_PORT=10000
DB_PASSWORD=local-only-change-me
MYSQL_ROOT_PASSWORD=local-root-change-me
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
# Demo account passwords used by `composer seed` (admin required, customer optional).
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

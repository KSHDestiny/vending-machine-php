{
    "name": "kaungsathein/vending-machine",
    "description": "Vending machine system in Core PHP and MySQL",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "firebase/php-jwt": "^7.2.1"
    },
    "require-dev": {
        "phpstan/phpstan": "2.3.6",
        "phpunit/phpunit": "13.4.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "css": "sh bin/build-css.sh"
    },
    "config": {
        "sort-packages": true
    }
}
